# Backend. Copy to backend/.env or set these in the host's dashboard.

# leave unset to use the local sqlite file
# DATABASE_URL=postgresql://user:password@host:5432/vaidya

# where the database and recordings are written
# VAIDYA_DATA_DIR=/data

# replay the bundled sample instead of running models. Set this on any host
# without a GPU and without Ollama.
# VAIDYA_DEMO_MODE=true

# comma separated, no trailing slash
VAIDYA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# local model settings
VAIDYA_ASR_MODEL=small
VAIDYA_ASR_DEVICE=cuda
VAIDYA_ASR_COMPUTE=float16
VAIDYA_OLLAMA_URL=http://127.0.0.1:11434
VAIDYA_LLM_MODEL=llama3.2:3b


# Frontend. Copy to frontend/.env.local or set in Vercel.
# Leave unset locally: the vite dev proxy forwards /api to port 8000.
# VITE_API_URL=https://vaidya-api.onrender.com
