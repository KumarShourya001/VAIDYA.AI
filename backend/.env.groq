# Demo host with a Groq key. Used to check routing without a real key:
#   uvicorn app.main:app --env-file .env.groq --port 8002
VAIDYA_DEMO_MODE=true
VAIDYA_GROQ_API_KEY=gsk_not_a_real_key_for_routing_checks
VAIDYA_ASR_DEVICE=cpu
VAIDYA_ASR_COMPUTE=int8
VAIDYA_ASR_MODEL=tiny
VAIDYA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
